<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="700.0" prefWidth="1200.0" 
            styleClass="bg-main" 
            stylesheets="@../../resources/styles/modern-design.css" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="goksoft.chat.app.controller.main.MainPanelController">
    
    <!-- Main Split Pane - RESIZABLE! -->
    <SplitPane fx:id="splitPane" 
               dividerPositions="0.28" 
               prefHeight="700.0" prefWidth="1200.0" 
               AnchorPane.bottomAnchor="0.0" 
               AnchorPane.leftAnchor="0.0" 
               AnchorPane.rightAnchor="0.0" 
               AnchorPane.topAnchor="0.0">
        
        <!-- LEFT SIDEBAR -->
        <AnchorPane minWidth="280.0" prefWidth="336.0" styleClass="sidebar-panel">
            <BorderPane fx:id="leftBorderPane" 
                        AnchorPane.bottomAnchor="0.0" 
                        AnchorPane.leftAnchor="0.0" 
                        AnchorPane.rightAnchor="0.0" 
                        AnchorPane.topAnchor="0.0">
                
                <!-- BOTTOM TOOLBAR -->
                <bottom>
                    <HBox fx:id="operationsHBox" 
                          alignment="CENTER" 
                          spacing="8.0" 
                          styleClass="panel-header"
                          prefHeight="70.0">
                        <padding>
                            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0" />
                        </padding>
                        
                        <!-- Settings Button -->
                        <Circle fx:id="settingsButton" 
                                radius="20.0" 
                                styleClass="avatar"
                                onMouseClicked="#toggleSettingsPanel">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Circle>
                        
                        <!-- Mailbox Button with Emoji Icon -->
                        <Button fx:id="mailboxButton" 
                                text="📬 Innboks" 
                                styleClass="btn-secondary"
                                maxWidth="Infinity"
                                prefHeight="36.0"
                                onMouseClicked="#showNotificationsPanel"
                                HBox.hgrow="ALWAYS">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        
                        <!-- Add Friend Button with Emoji Icon -->
                        <Button fx:id="addFriendButton" 
                                text="➕ Legg til" 
                                styleClass="btn-primary"
                                maxWidth="Infinity"
                                prefHeight="36.0"
                                onMouseClicked="#showUserSearchPanel"
                                HBox.hgrow="ALWAYS">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </HBox>
                </bottom>
                
                <!-- CENTER CONTENT -->
                <center>
                    <VBox fx:id="contentContainer" 
                          spacing="0.0" 
                          styleClass="bg-sidebar">
                        
                        <!-- FRIEND LIST PANEL -->
                        <VBox fx:id="friendListPanel" VBox.vgrow="ALWAYS">
                            
                            <!-- Search Bar -->
                            <HBox alignment="CENTER" 
                                  styleClass="panel-header"
                                  prefHeight="64.0">
                                <padding>
                                    <Insets top="12.0" right="16.0" bottom="12.0" left="16.0" />
                                </padding>
                                <TextField fx:id="searchFriendField" 
                                           promptText="🔍 Søk i venner" 
                                           styleClass="search-field"
                                           onKeyTyped="#searchFriend"
                                           HBox.hgrow="ALWAYS" />
                            </HBox>
                            
                            <!-- No Friends Label -->
                            <Label fx:id="noFriendLabel" 
                                   text="Ingen venner ennå. Bruk ➕ for å legge til!" 
                                   styleClass="label-tertiary text-sm"
                                   alignment="CENTER"
                                   wrapText="true"
                                   managed="false" 
                                   visible="false">
                                <padding>
                                    <Insets top="32.0" right="24.0" left="24.0" />
                                </padding>
                            </Label>
                            
                            <!-- Friends ScrollPane -->
                            <ScrollPane fx:id="friendScrollPane" 
                                        fitToWidth="true" 
                                        VBox.vgrow="ALWAYS">
                                <VBox fx:id="friendsVBox" spacing="2.0">
                                    <padding>
                                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                                    </padding>
                                </VBox>
                            </ScrollPane>
                        </VBox>
                        
                        <!-- NOTIFICATIONS PANEL -->
                        <VBox fx:id="notificationsPanel" 
                              managed="false" 
                              visible="false" 
                              VBox.vgrow="ALWAYS">
                            
                            <!-- Header -->
                            <HBox styleClass="panel-header" 
                                  prefHeight="64.0"
                                  alignment="CENTER_LEFT">
                                <padding>
                                    <Insets left="16.0" />
                                </padding>
                                <Label text="Venneforespørsler" 
                                       styleClass="label-primary text-lg font-semibold" />
                            </HBox>
                            
                            <!-- No Notifications Label -->
                            <Label fx:id="noNotifLabel" 
                                   text="Ingen nye forespørsler" 
                                   styleClass="label-tertiary text-sm"
                                   alignment="CENTER">
                                <padding>
                                    <Insets top="32.0" />
                                </padding>
                            </Label>
                            
                            <!-- Notifications ScrollPane -->
                            <ScrollPane fitToWidth="true" 
                                        VBox.vgrow="ALWAYS">
                                <VBox fx:id="notificationVBox" spacing="2.0">
                                    <padding>
                                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                                    </padding>
                                </VBox>
                            </ScrollPane>
                        </VBox>
                        
                        <!-- ADD FRIEND PANEL -->
                        <VBox fx:id="addfriendListPanel" 
                              managed="false" 
                              visible="false" 
                              VBox.vgrow="ALWAYS">
                            
                            <!-- Header -->
                            <HBox styleClass="panel-header" 
                                  prefHeight="64.0"
                                  alignment="CENTER_LEFT">
                                <padding>
                                    <Insets left="16.0" />
                                </padding>
                                <Label text="Finn nye venner" 
                                       styleClass="label-primary text-lg font-semibold" />
                            </HBox>
                            
                            <!-- No Users Label -->
                            <Label fx:id="noUserLabel" 
                                   text="Ingen resultater" 
                                   styleClass="label-tertiary text-sm"
                                   alignment="CENTER"
                                   managed="false"
                                   visible="false">
                                <padding>
                                    <Insets top="32.0" />
                                </padding>
                            </Label>
                            
                            <!-- Users ScrollPane -->
                            <ScrollPane fitToWidth="true" 
                                        VBox.vgrow="ALWAYS">
                                <VBox fx:id="usersVBox" spacing="2.0">
                                    <padding>
                                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0" />
                                    </padding>
                                </VBox>
                            </ScrollPane>
                            
                            <!-- Search Input at Bottom -->
                            <HBox alignment="CENTER" 
                                  styleClass="panel-header"
                                  prefHeight="64.0">
                                <padding>
                                    <Insets top="12.0" right="16.0" bottom="12.0" left="16.0" />
                                </padding>
                                <TextField fx:id="searchUserField" 
                                           promptText="🔍 Søk brukere..." 
                                           styleClass="search-field"
                                           onKeyTyped="#searchUsers"
                                           HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                    </VBox>
                </center>
            </BorderPane>
        </AnchorPane>
        
        <!-- RIGHT MAIN AREA -->
        <AnchorPane minWidth="600.0" styleClass="bg-chat">
            
            <!-- CHAT PANEL -->
            <BorderPane fx:id="chatBorderPane" 
                        managed="false"
                        visible="false"
                        AnchorPane.bottomAnchor="0.0" 
                        AnchorPane.leftAnchor="0.0" 
                        AnchorPane.rightAnchor="0.0" 
                        AnchorPane.topAnchor="0.0">
                
                <!-- CHAT HEADER -->
                <top>
                    <HBox alignment="CENTER_LEFT" 
                          spacing="16.0" 
                          styleClass="panel-header"
                          prefHeight="64.0">
                        <padding>
                            <Insets left="24.0" right="24.0" />
                        </padding>
                        
                        <!-- Friend Avatar -->
                        <Circle fx:id="chatFriendProfilePhoto" 
                                radius="20.0" 
                                styleClass="avatar" />
                        
                        <!-- Friend Name -->
                        <Label fx:id="chatFriendName" 
                               text="Velg en venn" 
                               styleClass="label-primary text-lg font-semibold"
                               HBox.hgrow="ALWAYS" />
                    </HBox>
                </top>
                
                <!-- MESSAGES LIST -->
                <center>
                    <ListView fx:id="listView" styleClass="list-view message-list" BorderPane.alignment="CENTER">
                        <padding>
                            <Insets top="16.0" bottom="16.0" />
                        </padding>
                    </ListView>
                </center>
                
                <!-- MESSAGE INPUT -->
                <bottom>
                    <HBox alignment="CENTER" 
                          spacing="12.0" 
                          styleClass="panel-header"
                          prefHeight="80.0">
                        <padding>
                            <Insets top="16.0" right="24.0" bottom="16.0" left="24.0" />
                        </padding>
                        
                        <TextField fx:id="messageField" 
                                   promptText="Skriv en melding..." 
                                   styleClass="message-input"
                                   prefHeight="48.0"
                                   HBox.hgrow="ALWAYS" />
                    </HBox>
                </bottom>
            </BorderPane>
            
            <!-- SETTINGS PANEL -->
            <BorderPane fx:id="settingsBorderPane" 
                        managed="false"
                        visible="false"
                        styleClass="bg-main"
                        AnchorPane.bottomAnchor="0.0" 
                        AnchorPane.leftAnchor="0.0" 
                        AnchorPane.rightAnchor="0.0" 
                        AnchorPane.topAnchor="0.0">
                
                <!-- Settings Content -->
                <center>
                    <VBox alignment="TOP_CENTER" 
                          spacing="32.0"
                          BorderPane.alignment="CENTER">
                        <padding>
                            <Insets top="64.0" />
                        </padding>
                        
                        <!-- Avatar -->
                        <Circle fx:id="profilePhoto" 
                                radius="64.0" 
                                styleClass="avatar" />
                        
                        <!-- Username -->
                        <Label fx:id="settingsUsername" 
                               text="Brukernavn" 
                               styleClass="label-primary text-2xl font-bold" />
                        
                        <!-- Logout Button -->
                        <Button fx:id="logoffButton" 
                                text="🚪 Logg ut" 
                                styleClass="btn-danger"
                                prefHeight="44.0"
                                prefWidth="200.0"
                                onMouseClicked="#logOff">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        
                        <!-- Footer -->
                        <Label text="Chat App v2.0.0" 
                               styleClass="label-tertiary text-xs">
                            <VBox.margin>
                                <Insets top="64.0" />
                            </VBox.margin>
                        </Label>
                    </VBox>
                </center>
            </BorderPane>
        </AnchorPane>
    </SplitPane>
</AnchorPane>
