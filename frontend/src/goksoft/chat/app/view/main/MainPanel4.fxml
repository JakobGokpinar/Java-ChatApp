<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
    MainPanel.fxml — Complete Redesign
    All fx:id and event handler bindings preserved for MainPanelController1 compatibility.
-->

<AnchorPane prefHeight="640.0" prefWidth="960.0"
            styleClass="main-root"
            stylesheets="@../../resources/styles/app-styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="goksoft.chat.app.controller.main.MainPanelController">

    <SplitPane fx:id="splitPane" dividerPositions="0.32"
               styleClass="split-pane"
               AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- ======================================================
             LEFT SIDEBAR (300px)
             ====================================================== -->
        <BorderPane styleClass="sidebar" minWidth="270" maxWidth="360"
                    SplitPane.resizableWithParent="false">

            <!-- ── SIDEBAR TOP: User info + Search ── -->
            <top>
                <VBox styleClass="sidebar-header" spacing="14">

                    <!-- User row: avatar + name + status -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Circle fx:id="settingsButton" radius="18"
                                styleClass="profile-circle-default"
                                onMouseClicked="#toggleSettingsPanel" />
                        <VBox spacing="1" HBox.hgrow="ALWAYS">
                            <Label text="Chats" styleClass="sidebar-title" />
                        </VBox>
                    </HBox>

                    <!-- Search field -->
                    <TextField fx:id="searchFriendField"
                               promptText="Search..."
                               onKeyTyped="#searchFriend"
                               styleClass="sidebar-search"
                               focusTraversable="false" />
                </VBox>
            </top>

            <!-- ── SIDEBAR CENTER: Nav + Content panels ── -->
            <center>
                <VBox fx:id="contentContainer" styleClass="sidebar-content"
                      VBox.vgrow="ALWAYS">

                    <!-- Navigation items -->
                    <VBox styleClass="sidebar-nav">
                        <Button fx:id="mailboxButton" text="⬡  Requests"
                                onMouseClicked="#showNotificationsPanel"
                                styleClass="nav-btn"
                                maxWidth="1.7976931348623157E308" />
                        <Button text="＋  Find People"
                                onMouseClicked="#showUserSearchPanel"
                                styleClass="nav-btn"
                                maxWidth="1.7976931348623157E308" />
                    </VBox>

                    <!-- Divider -->
                    <Region styleClass="sidebar-divider">
                        <VBox.margin><Insets left="14" right="14" top="4" bottom="4" /></VBox.margin>
                    </Region>

                    <!-- ── PANEL 1: Friends / Chat List ── -->
                    <VBox fx:id="friendListPanel" VBox.vgrow="ALWAYS">

                        <Label fx:id="noFriendLabel"
                               text="No conversations yet&#10;Add friends to get started"
                               styleClass="empty-state-label"
                               alignment="CENTER"
                               maxWidth="1.7976931348623157E308"
                               managed="false" visible="false">
                            <VBox.margin><Insets top="48" /></VBox.margin>
                        </Label>

                        <ScrollPane fx:id="friendScrollPane"
                                    fitToWidth="true" fitToHeight="true"
                                    hbarPolicy="NEVER"
                                    VBox.vgrow="ALWAYS">
                            <VBox fx:id="friendsVBox" styleClass="sidebar-content" />
                        </ScrollPane>
                    </VBox>

                    <!-- ── PANEL 2: Friend Requests ── -->
                    <VBox fx:id="notificationsPanel" managed="false" visible="false"
                          VBox.vgrow="ALWAYS">

                        <HBox styleClass="sidebar-section-header" alignment="CENTER_LEFT"
                              spacing="8">
                            <Label text="Friend Requests" styleClass="sidebar-section-title" />
                        </HBox>

                        <Label fx:id="noNotifLabel"
                               text="No pending requests"
                               styleClass="empty-state-label"
                               alignment="CENTER"
                               maxWidth="1.7976931348623157E308" />

                        <ScrollPane fitToWidth="true" fitToHeight="true"
                                    hbarPolicy="NEVER"
                                    VBox.vgrow="ALWAYS">
                            <VBox fx:id="notificationVBox" styleClass="sidebar-content"
                                  spacing="10">
                                <padding><Insets top="10" left="12" right="12" bottom="10" /></padding>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                    <!-- ── PANEL 3: User Search ── -->
                    <VBox fx:id="addFriendListPanel" managed="false" visible="false"
                          VBox.vgrow="ALWAYS">

                        <HBox styleClass="sidebar-section-header" alignment="CENTER_LEFT">
                            <Label text="Find People" styleClass="sidebar-section-title" />
                        </HBox>

                        <!-- Search input -->
                        <HBox alignment="CENTER" spacing="0">
                            <padding><Insets top="10" left="14" right="14" bottom="6" /></padding>
                            <TextField fx:id="searchUserField"
                                       promptText="Search by username..."
                                       onKeyTyped="#searchUsers"
                                       styleClass="sidebar-search"
                                       HBox.hgrow="ALWAYS" />
                        </HBox>

                        <Label fx:id="noUserLabel"
                               text="Type a username to find people"
                               styleClass="empty-state-label"
                               alignment="CENTER"
                               maxWidth="1.7976931348623157E308">
                            <padding><Insets top="20" /></padding>
                        </Label>

                        <ScrollPane fitToWidth="true" fitToHeight="true"
                                    hbarPolicy="NEVER"
                                    VBox.vgrow="ALWAYS">
                            <VBox fx:id="usersVBox" styleClass="sidebar-content"
                                  spacing="10">
                                <padding><Insets top="10" left="12" right="12" bottom="10" /></padding>
                            </VBox>
                        </ScrollPane>
                    </VBox>

                </VBox>
            </center>

            <!-- ── SIDEBAR BOTTOM: kept for operationsHBox binding ── -->
            <bottom>
                <HBox fx:id="operationsHBox" alignment="CENTER" spacing="0"
                      managed="false" visible="false" prefHeight="0" />
            </bottom>
        </BorderPane>

        <!-- ======================================================
             RIGHT CONTENT AREA
             ====================================================== -->
        <AnchorPane styleClass="chat-panel" minWidth="480">

            <!-- ── Empty State ── -->
            <VBox fx:id="chatEmptyState" alignment="CENTER" spacing="12"
                  AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                  AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

                <!-- Icon container -->
                <StackPane minWidth="72" minHeight="72"
                           maxWidth="72" maxHeight="72"
                           prefWidth="72" prefHeight="72"
                           style="-fx-background-color: #1a1a3a; -fx-background-radius: 20;">
                    <Label text="💬" style="-fx-font-size: 28px;" />
                </StackPane>
                <Region prefHeight="4" />
                <Label text="Welcome to Chat" styleClass="chat-empty-title" />
                <Label text="Select a conversation or find new people to connect"
                       styleClass="chat-empty-subtitle"
                       wrapText="true" maxWidth="300" alignment="CENTER"
                       style="-fx-text-alignment: center;" />
            </VBox>

            <!-- ── Chat Panel ── -->
            <BorderPane fx:id="chatBorderPane" visible="false"
                        styleClass="chat-panel"
                        AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                        AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

                <!-- Chat header -->
                <top>
                    <HBox alignment="CENTER_LEFT" spacing="14"
                          styleClass="chat-header">
                        <Circle fx:id="chatFriendProfilePhoto" radius="20"
                                styleClass="profile-circle-default" />
                        <VBox spacing="2">
                            <Label fx:id="chatFriendName" text=""
                                   styleClass="chat-friend-name" />
                            <Label text="Online" styleClass="chat-status-online" />
                        </VBox>
                    </HBox>
                </top>

                <!-- Messages -->
                <center>
                    <ListView fx:id="listView" styleClass="list-view" />
                </center>

                <!-- Input bar -->
                <bottom>
                    <HBox alignment="CENTER" spacing="12"
                          styleClass="chat-input-bar">
                        <TextField fx:id="messageField"
                                   promptText="Type a message..."
                                   styleClass="chat-input"
                                   HBox.hgrow="ALWAYS" />
                        <Button fx:id="sendButton" text="↑"
                                onMouseClicked="#sendMessageButton"
                                styleClass="btn-send" />
                    </HBox>
                </bottom>
            </BorderPane>

            <!-- ── Settings Panel ── -->
            <BorderPane fx:id="settingsBorderPane" visible="false"
                        styleClass="settings-panel"
                        AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                        AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

                <top>
                    <HBox alignment="CENTER_LEFT" styleClass="settings-header">
                        <Label text="Settings" styleClass="settings-title" />
                    </HBox>
                </top>

                <center>
                    <VBox alignment="TOP_CENTER" spacing="20">
                        <padding><Insets top="48" left="48" right="48" /></padding>

                        <!-- Profile card -->
                        <VBox alignment="CENTER" spacing="12"
                              styleClass="settings-card" maxWidth="340">
                            <Circle fx:id="profilePhoto" radius="44"
                                    styleClass="profile-circle-default" />
                            <Region prefHeight="4" />
                            <Label fx:id="settingsUsername" text=""
                                   styleClass="settings-username" />
                            <Label text="Active now" styleClass="settings-label" />
                        </VBox>

                        <Region prefHeight="4" />

                        <!-- Info card -->
                        <VBox alignment="CENTER" spacing="10"
                              styleClass="settings-card" maxWidth="340">
                            <HBox alignment="CENTER" spacing="0">
                                <Label text="Version" styleClass="settings-info-label"
                                       HBox.hgrow="ALWAYS"
                                       maxWidth="1.7976931348623157E308" />
                                <Label text="1.0.0" styleClass="settings-label"
                                       style="-fx-font-family: 'JetBrains Mono', monospace;" />
                            </HBox>
                            <Region styleClass="settings-divider" />
                            <HBox alignment="CENTER" spacing="0">
                                <Label text="Built with" styleClass="settings-info-label"
                                       HBox.hgrow="ALWAYS"
                                       maxWidth="1.7976931348623157E308" />
                                <Label text="Java 21 + Spring Boot" styleClass="settings-label" />
                            </HBox>
                        </VBox>

                        <Region prefHeight="8" />

                        <!-- Logout -->
                        <Button text="Log Out"
                                onMouseClicked="#logOff"
                                styleClass="btn-logout"
                                maxWidth="180" prefHeight="40" />
                    </VBox>
                </center>
            </BorderPane>
        </AnchorPane>
    </SplitPane>
</AnchorPane>
