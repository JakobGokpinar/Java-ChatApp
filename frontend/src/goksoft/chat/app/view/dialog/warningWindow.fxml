<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" 
      prefHeight="140.0" prefWidth="400.0" 
      spacing="16.0"
      styleClass="card" 
      stylesheets="@../../resources/styles/modern-design.css" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="goksoft.chat.app.controller.dialog.WarningWindowController">
    
    <padding>
        <Insets top="32.0" right="32.0" bottom="32.0" left="32.0" />
    </padding>
    
    <!-- Icon (emoji) -->
    <Label text="⚠️" styleClass="text-4xl" />
    
    <!-- Message -->
    <Label fx:id="messageLabel" 
           text="Varselmelding!" 
           alignment="CENTER" 
           wrapText="true"
           maxWidth="336.0"
           styleClass="label-primary text-base">
        <padding>
            <Insets top="8.0" bottom="8.0" />
        </padding>
    </Label>
</VBox>
