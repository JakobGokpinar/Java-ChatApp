<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="500.0" prefWidth="600.0"
           styleClass="auth-background"
           stylesheets="@../../resources/styles/app-styles.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="goksoft.chat.app.controller.auth.LoginController">

    <!-- Centered auth card -->
    <VBox alignment="CENTER" maxWidth="340" maxHeight="440" spacing="0"
          styleClass="auth-card">
        <padding>
            <Insets top="36" right="36" bottom="32" left="36" />
        </padding>

        <!-- App icon circle -->
        <Circle radius="28" styleClass="profile-circle-default" />

        <Region prefHeight="16" />

        <!-- Title -->
        <Label text="Welcome back" styleClass="auth-title" />

        <Region prefHeight="4" />

        <Label text="Sign in to continue to Chat" styleClass="auth-subtitle" />

        <Region prefHeight="28" />

        <!-- Username field -->
        <TextField fx:id="usernameField"
                   promptText="Username"
                   styleClass="auth-input"
                   maxWidth="1.7976931348623157E308" />

        <Region prefHeight="12" />

        <!-- Password field (and hidden plain-text toggle) -->
        <PasswordField fx:id="passwordField"
                       promptText="Password"
                       styleClass="auth-input"
                       maxWidth="1.7976931348623157E308" />

        <TextField fx:id="textField"
                   styleClass="auth-input"
                   maxWidth="1.7976931348623157E308"
                   visible="false" managed="false" />

        <Region prefHeight="10" />

        <!-- Options row -->
        <HBox alignment="CENTER_LEFT" spacing="0">
            <CheckBox fx:id="rememberMeButton"
                      text="Remember me"
                      onMouseClicked="#rememberMeListener"
                      styleClass="auth-checkbox" />
            <Region HBox.hgrow="ALWAYS" />
            <CheckBox fx:id="showPasswordButton"
                      text="Show password"
                      onMouseClicked="#showPassword"
                      styleClass="auth-checkbox" />
        </HBox>

        <Region prefHeight="24" />

        <!-- Sign in button -->
        <Button fx:id="signinbutton"
                text="Sign In"
                onMouseClicked="#signInButton"
                styleClass="auth-btn-primary"
                maxWidth="1.7976931348623157E308"
                prefHeight="42" />

        <Region prefHeight="20" />

        <!-- Register link -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Don't have an account?"
                   styleClass="auth-subtitle" />
            <Label text="Create one"
                   onMouseClicked="#changeSceneToRegister"
                   styleClass="auth-link" />
        </HBox>
    </VBox>
</StackPane>