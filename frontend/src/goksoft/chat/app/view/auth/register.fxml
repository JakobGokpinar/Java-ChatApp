<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!--
    register.fxml — Updated to match new indigo accent palette
-->

<StackPane prefHeight="650" prefWidth="650"
           styleClass="auth-background"
           stylesheets="@../../resources/styles/app-styles.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="goksoft.chat.app.controller.auth.RegisterController">

    <!-- Auth card -->
    <VBox alignment="CENTER" maxWidth="340" maxHeight="520" spacing="0"
          styleClass="auth-card">
        <padding>
            <Insets top="36" right="36" bottom="32" left="36" />
        </padding>

        <!-- Gradient logo icon -->
        <StackPane maxWidth="60" maxHeight="60" minWidth="60" minHeight="60">
            <Rectangle width="60" height="60" arcWidth="18" arcHeight="18"
                       style="-fx-fill: linear-gradient(to bottom right, #5B7FFF, #8B5CF6);" />
            <Label text="💬" style="-fx-font-size: 24px;" />
        </StackPane>

        <Region prefHeight="18" />

        <!-- Title -->
        <Label text="Create account" styleClass="auth-title" />

        <Region prefHeight="4" />

        <Label text="Join Chat to start messaging" styleClass="auth-subtitle" />

        <Region prefHeight="28" />

        <!-- Username field -->
        <TextField fx:id="usernameField"
                   promptText="Username"
                   styleClass="auth-input"
                   maxWidth="1.7976931348623157E308" />

        <Region prefHeight="12" />

        <!-- Password fields -->
        <StackPane maxWidth="1.7976931348623157E308">
            <PasswordField fx:id="passwordField1"
                           promptText="Password"
                           styleClass="auth-input"
                           maxWidth="1.7976931348623157E308" />
            <TextField fx:id="textField1"
                       promptText="Password"
                       styleClass="auth-input"
                       visible="false"
                       maxWidth="1.7976931348623157E308" />
        </StackPane>

        <Region prefHeight="12" />

        <StackPane maxWidth="1.7976931348623157E308">
            <PasswordField fx:id="passwordField2"
                           promptText="Confirm password"
                           styleClass="auth-input"
                           maxWidth="1.7976931348623157E308" />
            <TextField fx:id="textField2"
                       promptText="Confirm password"
                       styleClass="auth-input"
                       visible="false"
                       maxWidth="1.7976931348623157E308" />
        </StackPane>

        <Region prefHeight="20" />

        <!-- Show passwords -->
        <HBox alignment="CENTER_LEFT">
            <CheckBox fx:id="showPasswordsButton"
                      text="Show passwords"
                      onMouseClicked="#showPasswords"
                      styleClass="auth-checkbox" />
        </HBox>

        <Region prefHeight="20" />

        <!-- Sign up button -->
        <Button text="Create Account"
                onMouseClicked="#registerButton"
                styleClass="auth-btn-primary"
                maxWidth="1.7976931348623157E308"
                prefHeight="44" />

        <Region prefHeight="20" />

        <!-- Login link -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Already have an account?" styleClass="auth-subtitle" />
            <Label text="Sign in"
                   styleClass="auth-link"
                   onMouseClicked="#changeSceneToLogin" />
        </HBox>
    </VBox>
</StackPane>
