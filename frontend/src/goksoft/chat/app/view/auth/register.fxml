<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="500.0" prefWidth="600.0"
           styleClass="auth-background"
           stylesheets="@../../resources/styles/app-styles.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="goksoft.chat.app.controller.auth.RegisterController">

    <!-- Centered auth card -->
    <VBox alignment="CENTER" maxWidth="340" maxHeight="480" spacing="0"
          styleClass="auth-card">
        <padding>
            <Insets top="36" right="36" bottom="32" left="36" />
        </padding>

        <!-- App icon circle -->
        <Circle radius="28" styleClass="profile-circle-default" />

        <Region prefHeight="16" />

        <!-- Title -->
        <Label text="Create Account" styleClass="auth-title" />

        <Region prefHeight="4" />

        <Label text="Join Chat to start messaging" styleClass="auth-subtitle" />

        <Region prefHeight="28" />

        <!-- Username field -->
        <TextField fx:id="usernameField"
                   promptText="Username"
                   styleClass="auth-input"
                   maxWidth="1.7976931348623157E308" />

        <Region prefHeight="12" />

        <!-- Password fields -->
        <PasswordField fx:id="passwordField1"
                       promptText="Password"
                       styleClass="auth-input"
                       maxWidth="1.7976931348623157E308" />

        <TextField fx:id="textField1"
                   styleClass="auth-input"
                   maxWidth="1.7976931348623157E308"
                   visible="false" managed="false" />

        <Region prefHeight="12" />

        <PasswordField fx:id="passwordField2"
                       promptText="Confirm password"
                       styleClass="auth-input"
                       maxWidth="1.7976931348623157E308" />

        <TextField fx:id="textField2"
                   styleClass="auth-input"
                   maxWidth="1.7976931348623157E308"
                   visible="false" managed="false" />

        <Region prefHeight="10" />

        <!-- Show passwords -->
        <HBox alignment="CENTER_LEFT">
            <CheckBox fx:id="showPasswordsButton"
                      text="Show passwords"
                      onMouseClicked="#showPasswords"
                      styleClass="auth-checkbox" />
        </HBox>

        <Region prefHeight="24" />

        <!-- Sign up button -->
        <Button text="Create Account"
                onMouseClicked="#registerButton"
                styleClass="auth-btn-primary"
                maxWidth="1.7976931348623157E308"
                prefHeight="42" />

        <Region prefHeight="12" />

        <!-- Back to Login -->
        <Button text="Back to Sign In"
                onAction="#changeSceneToLogin"
                styleClass="auth-btn-secondary"
                maxWidth="1.7976931348623157E308"
                prefHeight="36" />
    </VBox>
</StackPane>
