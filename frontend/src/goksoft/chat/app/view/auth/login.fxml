<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="600.0" prefWidth="900.0" 
            stylesheets="@../../resources/styles/modern-design.css" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="goksoft.chat.app.controller.auth.LoginController">
    
    <!-- Background Image Layer -->
    <AnchorPane prefHeight="600.0" prefWidth="900.0" 
                style="-fx-background-image: url('/goksoft/chat/app/resources/images/backgrounds/login-bg.jpg'); 
                       -fx-background-size: cover; 
                       -fx-background-position: center;" 
                AnchorPane.bottomAnchor="0.0" 
                AnchorPane.leftAnchor="0.0" 
                AnchorPane.rightAnchor="0.0" 
                AnchorPane.topAnchor="0.0">
        
        <!-- Semi-transparent overlay -->
        <AnchorPane prefHeight="600.0" prefWidth="900.0" 
                    style="-fx-background-color: rgba(0, 0, 0, 0.3);" 
                    AnchorPane.bottomAnchor="0.0" 
                    AnchorPane.leftAnchor="0.0" 
                    AnchorPane.rightAnchor="0.0" 
                    AnchorPane.topAnchor="0.0">
            
            <!-- Login Card -->
            <VBox alignment="CENTER" spacing="24.0" styleClass="auth-card" 
                  AnchorPane.leftAnchor="240.0" AnchorPane.rightAnchor="240.0" 
                  AnchorPane.topAnchor="120.0">
                
                <!-- Header -->
                <VBox alignment="CENTER" spacing="8.0">
                    <Label text="Velkommen tilbake" styleClass="auth-header" />
                    <Label text="Logg inn for å fortsette" styleClass="auth-subtitle" />
                </VBox>
                
                <!-- Form -->
                <VBox spacing="16.0">
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                    
                    <!-- Username -->
                    <VBox spacing="6.0">
                        <Label text="Brukernavn" styleClass="label-secondary text-sm" />
                        <TextField fx:id="usernameField" 
                                   promptText="Skriv inn brukernavn" 
                                   prefHeight="44.0" />
                    </VBox>
                    
                    <!-- Password -->
                    <VBox spacing="6.0">
                        <Label text="Passord" styleClass="label-secondary text-sm" />
                        <PasswordField fx:id="passwordField" 
                                       promptText="Skriv inn passord" 
                                       prefHeight="44.0" />
                        <TextField fx:id="textField" 
                                   prefHeight="44.0"
                                   visible="false" 
                                   managed="false" />
                    </VBox>
                    
                    <!-- Options -->
                    <HBox spacing="16.0" alignment="CENTER_LEFT">
                        <CheckBox fx:id="rememberMeButton" 
                                  text="Husk meg" 
                                  onMouseClicked="#rememberMeListener" />
                        <CheckBox fx:id="showPasswordButton" 
                                  text="Vis passord" 
                                  onMouseClicked="#showPassword" />
                    </HBox>
                    
                    <!-- Submit Button -->
                    <Button fx:id="signinbutton" 
                            text="Logg inn" 
                            styleClass="btn-primary"
                            prefHeight="44.0"
                            maxWidth="Infinity"
                            onMouseClicked="#signInButton"
                            defaultButton="true">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                        <VBox.margin>
                            <Insets top="8.0" />
                        </VBox.margin>
                    </Button>
                </VBox>
                
                <!-- Register Link -->
                <HBox alignment="CENTER" spacing="6.0">
                    <VBox.margin>
                        <Insets top="8.0" />
                    </VBox.margin>
                    <Label text="Ikke medlem?" styleClass="label-secondary text-sm" />
                    <Label text="Registrer deg nå" 
                           styleClass="label-primary text-sm font-semibold"
                           onMouseClicked="#changeSceneToRegister" 
                           underline="true">
                        <cursor>
                            <Cursor fx:constant="HAND" />
                        </cursor>
                    </Label>
                </HBox>
            </VBox>
        </AnchorPane>
    </AnchorPane>
</AnchorPane>
